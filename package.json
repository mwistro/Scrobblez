{
  "name": "scrobblez",
  "version": "1.0.0",
  "description": "A TypeScript CLI exploring Last.fm authentication, signed API requests and batched scrobbling.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/main.js",
    "demo": "npm run build && node dist/main.js --demo",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "author": "Mateus Maistro",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.20",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "node-fetch": "^3.3.2",
    "open": "^10.1.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mwistro/Scrobblez.git"
  }
}
